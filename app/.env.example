# Supabase project credentials (see specs/006-customer-data-storage/contracts/database-schema.md)
# Copy this file to .env.local and fill in real values. .env.local is gitignored.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Coach password for the dashboard (server/auth.js). Required on any public
# deployment: when unset, the API is open to anyone who can reach it. Use a long
# random value, e.g. `openssl rand -base64 24`.
COACH_ACCESS_TOKEN=
