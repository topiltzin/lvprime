# Supabase project credentials (see specs/006-customer-data-storage/contracts/database-schema.md)
# Copy this file to .env.local and fill in real values. .env.local is gitignored.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Coach sign-in uses Supabase Auth users from this project (server/auth.js).
# Optional: a long random value to sign session cookies, e.g. `openssl rand -base64 32`.
# When unset, a key derived from SUPABASE_SECRET_KEY is used.
SESSION_SECRET=
# Local development only: set to true to skip sign-in. Never set it in a deployment.
COACH_AUTH_DISABLED=

# Fitness coach chatbot (specs/013-fitness-coach-chatbot).
# CHATBOT_PROVIDER selects the upstream: `lightning` (default) or `gemini`.
CHATBOT_PROVIDER=lightning
# --- lightning: Full URL of the upstream
# /chat endpoint, e.g. https://8000-<id>.cloudspaces.litng.ai/chat. When unset,
# /api/chat answers 503 chatbot_not_configured.
CHATBOT_URL=
# Optional shared secret sent as `Authorization: Bearer <key>`. Set the same value as
# CHATBOT_API_KEY on the Lightning studio so only this server can call the chatbot.
CHATBOT_API_KEY=

# --- gemini (CHATBOT_PROVIDER=gemini): Google Interactions API.
GEMINI_API_KEY=
# Optional overrides; defaults shown.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/interactions

# Customer password-reset emails, sent with Resend (server/lib/email.js).
# EMAIL_API_KEY: Resend API key. EMAIL_FROM: sender, e.g. onboarding@resend.dev (Resend only
# delivers that sender to your own account email; verify a domain to email customers).
EMAIL_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# Public URL of this app, used in the reset link (no trailing slash).
APP_URL=http://localhost:5173
